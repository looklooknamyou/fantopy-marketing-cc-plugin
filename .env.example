# Fantopy Marketing Agents — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=

# GitHub
GITHUB_TOKEN=

# Twitter / X
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FantopyScout/1.0

# Google Sheets
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=  # path to JSON file
RECRUITER_SHEET_ID=                  # Agent 3 review queue
NURTURER_SHEET_ID=                   # Agent 15 logs

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=hello@fantopyarena.com

# Discord
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_INTEL_CHANNEL_ID=

# Fantopy Platform (from Marcus — Phase 2)
FANTOPY_API_KEY=
FANTOPY_API_BASE_URL=
MCP_GATEWAY_SSE_URL=    # SSE stream URL for contest.scored events

# Moltbook (Phase 2)
MOLTBOOK_API_KEY=

# Database (existing platform Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/fantopy

# Slack (optional — for intel reports)
SLACK_WEBHOOK_URL=
