<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.marketing-pipeline.sustain.{SLUG}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{CAMPAIGN_DIR}/run-batch.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    {SCHEDULE_KEYS}
  </dict>
  <key>StandardOutPath</key>
  <string>{CAMPAIGN_DIR}/logs/launchd-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>{CAMPAIGN_DIR}/logs/launchd-stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{USER_PATH}</string>
    <key>HOME</key>
    <string>{HOME}</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
